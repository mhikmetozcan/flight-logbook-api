# Copy this file to .env and fill in real values. Never commit .env itself.

# Get a free Postgres instance from Railway, Supabase, or Neon,
# or run one locally with: docker run --name flight-db -e POSTGRES_PASSWORD=postgres -p 5432:5432 -d postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/flight_logbook?schema=public"

JWT_SECRET="replace-with-a-long-random-string"

PORT=3000
